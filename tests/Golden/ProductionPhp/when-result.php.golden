<?php
declare(strict_types=1);
function identity(string $value): string { return $value; }
/**
 * @param list<string> $names
 */
function describeUsers(array $names): string {
    /** @var int $count */ $count = count($names);
    return $count === 0 ? "No users" : $count . " users: " . implode(", ", $names);
}
echo describeUsers([]), "|", describeUsers(["Maya"]);