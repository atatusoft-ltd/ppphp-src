<?php
declare(strict_types=1);
class Person {}
final class Member extends Person {}
/** @var string $name */ $name = 'Maya';
$summary = $name . ': done';
/** @var int $count */ $count = 1 + 2;
/** @var float $ratio */ $ratio = (float) $count / 2.0;
/** @var bool $ready */ $ready = (bool) $count;
/** @var list<int> $counts */ $counts = [1, 2];
$person = new Member();
$object = new Person();
function describe(string $name): string
{
    $summary = $name . ': done';
    return $summary;
}
/** @var array<string, int> $scores */ $scores = ['Maya' => 5];
/**
 * @var string $key
 * @var int $score
 */
foreach ($scores as $key => $score) {
    $line = $key . ': ' . $score;
    echo $line;
}
echo '|' . describe($name) . '|' . $summary;