<?php

function nested(int $x): int
{
    int $r = when ($x > 0) {
        int $inner = when ($x > 1) {
            return $x * 2;
        } else {
            return 0;
        };
        return $inner + 1;
    } else {
        return 0;
    };
    return $r;
}

echo nested(2), '|', nested(1), '|', nested(0);
