{
    "$schema": "https://raw.githubusercontent.com/composer/composer/main/res/composer-schema.json",
    "name": "atatusoft/ppphp",
    "description": "++PHP is a superset of PHP that compiles to clean PHP output.",
    "homepage": "https://ppphplang.org",
    "keywords": [
        "php",
        "compiler",
        "transpiler",
        "programming-language",
        "static-analysis",
        "generics"
    ],
    "support": {
        "issues": "https://github.com/atatusoft-ltd/ppphp-src/issues",
        "source": "https://github.com/atatusoft-ltd/ppphp-src"
    },
    "type": "library",
    "bin": [
        "bin/ppphp"
    ],
    "scripts": {
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "php -d memory_limit=512M vendor/bin/pest"
        ],
        "analyse": "phpstan analyse --configuration=phpstan.neon.dist --no-progress --memory-limit=512M",
        "verify:mixed-application": "php tests/Support/verify-mixed-application.php",
        "verify:analyzer-parity": "php tools/analyzer-parity.php --format=markdown",
        "verify:version": "php tools/verify-version.php",
        "verify:php-signatures": "php tools/verify-php-signatures.php",
        "verify:dependency-index": "php tools/verify-dependency-index.php",
        "verify:cache": "php tools/verify-cache.php",
        "verify:fuzz-smoke": "php tools/fuzz-smoke.php",
        "verify:analyzer-promotion": "php tools/analyzer-promotion-readiness.php --format=markdown",
        "verify:benchmark-harness": "php -d memory_limit=512M tools/benchmark-compiler.php --profile=smoke --iterations=1 --format=json",
        "verify:documentation": "php tools/verify-documentation.php",
        "verify:release-readiness": "php tools/release/verify-readiness.php",
        "verify:distribution": "php tools/verify-distribution.php",
        "check": [
            "@verify:version",
            "@verify:documentation",
            "@analyse",
            "@test",
            "@verify:php-signatures",
            "@verify:dependency-index",
            "@verify:cache",
            "@verify:fuzz-smoke",
            "@verify:benchmark-harness",
            "@verify:analyzer-promotion",
            "@verify:mixed-application",
            "@verify:analyzer-parity",
            "@verify:release-readiness"
        ]
    },
    "require": {
        "php": "^8.4",
        "composer/semver": "^3.4",
        "nikic/php-parser": "^5.6",
        "phpstan/phpstan": "^2.2",
        "symfony/console": "^8.1",
        "symfony/process": "^8.1",
        "phpstan/phpdoc-parser": "^2.3"
    },
    "replace": {
        "atatusoft-ltd/ppphp-src": "self.version"
    },
    "require-dev": {
        "pestphp/pest": "^5.1"
    },
    "license": "Apache-2.0",
    "autoload": {
        "psr-4": {
            "Atatusoft\\Ppphp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "/tests/Fixtures/DependencyIndex/project/vendor/"
        ]
    },
    "authors": [
        {
            "name": "Andrew Masiye",
            "email": "amasiye313@gmail.com"
        }
    ],
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
